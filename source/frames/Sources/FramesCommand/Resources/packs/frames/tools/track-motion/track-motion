#!/usr/bin/env python3
"""frames/track-motion: fills each `frames/track-motion` request of a document with the track data `frames track`
prints.

A request is an object with the key `tool` that stands where a value is still to be found, and the requests this tool
fills are those whose `tool` is `frames/track-motion`, standing as a clip's `track`. It reads from
`frames timeline --json` the media each clip's track follows and the frames it is followed over, and from
`frames timeline --at` the frame its target is written on and where the boxes and masks of clips lie there, follows the
target with `frames track`, and prints the same document with each of its requests replaced by that track data. A
request inside a compound clip written as a sequence object is read from `frames timeline --nested`, on the nested
sequence's own clock. A request for any other tool is left as written. It reads only frames' machine output and never a
resolved document.
"""

import json
import os
import shlex
import subprocess
import sys
import tempfile

GLOBAL_OPTIONS = ("--theme", "--decoder", "--renderer", "--mixer", "--encoder", "--shaper", "--tracker", "--ocr", "--memory")
TOOL = "frames/track-motion"
REQUEST_KEYS = {"tool", "target"}
CLIP_TARGET_KEYS = {"clip"}
TARGET_KEYS = ("area", "cornerPin", "crop", "mask")
AREA_KEYS = ("area", "crop")
PLACEHOLDER = [0, 0, 1, 1]
USAGE = """frames frames/track-motion <document.json | ->

Prints the document with every clip's track request replaced by the track data `frames track` prints for it:

  "track": {"tool": "frames/track-motion", "target": "area"}           the clip's own area
  "track": {"tool": "frames/track-motion", "target": [x, y, w, h]}     that area
  "track": {"tool": "frames/track-motion", "target": {"clip": "<id>"}} what the clip with that id covers

A target names one of the clip's own keys in the media pixels its track follows (area, cornerPin, crop, mask), is an
area in those pixels, or names a clip of the same sequence, whose box is carried into those pixels from where
timeline --at reports it. It is written on the frame the clip's instant shows, or where the key it names is keyframed,
the frame its first keyframe shows, and is followed from that frame. A mask is followed as the rectangle that bounds
the clip's masks. A corner pin and a clip's box are followed as quadrilaterals, in perspective with --tracker planar.
A request inside a compound clip written as a sequence object is filled on the nested sequence's own clock. A request
among a template instance's arguments stops. Track data and a request for any other tool are left as written.

  <document.json | ->           The document, as an absolute path, or - for standard input.
  --help                        Prints this help.

The global options of frames given before `frames/track-motion` are passed to every frames command it runs, so
`frames --tracker planar frames/track-motion doc.json` follows with the planar tracker. The frames it runs is the one
that runs it, whose executable frames gives in FRAMES_EXECUTABLE."""


class Stop(Exception):
    """A reason the document cannot be written, printed as `frames/track-motion: <reason>`."""


# MARK: - Frames

class Frames:
    """Runs frames commands and reads their machine output."""

    def __init__(self, executable, options):
        self.executable = executable
        self.options = options
        self.followed = {}

    def report(self, arguments):
        completed = subprocess.run(
            [self.executable] + self.options + arguments, capture_output=True, text=True
        )
        if completed.returncode != 0:
            message = completed.stderr.strip() or f"exit {completed.returncode}"
            raise Stop(f"{shlex.join(completed.args)} failed: {message}")
        return json.loads(completed.stdout)

    def track(self, media, time, target, end, color_space):
        """What `frames track` prints for the target followed from the frame at `time` to the frame at `end`."""
        arguments = ["track", media.path]
        if media.fps is not None:
            arguments += ["--fps", number_text(media.fps)]
        arguments += ["--at", number_text(time), target.option, json.dumps(target.value), "--to", number_text(end)]
        if color_space is not None:
            arguments += ["--color-space", color_space]
        key = tuple(arguments)
        if key not in self.followed:
            self.followed[key] = self.report(arguments)
        return self.followed[key]


# MARK: - Requests

class Clip:
    """A clip of the document at its place, as reports name it, and the place of the compound clip whose nested
    sequence holds it, None for a clip of the document's own sequence."""

    def __init__(self, value, place, nested=None):
        self.value = value
        self.place = place
        self.nested = nested

    def keyframes_writing(self, key):
        """The keyframes that write the key."""
        keyframes = self.value.get("keyframes")
        if not isinstance(keyframes, list):
            return []
        return [keyframe for keyframe in keyframes if isinstance(keyframe, dict) and key in keyframe]

    def written(self, key):
        """Whether the clip writes the key, on the clip or in a keyframe."""
        return key in self.value or bool(self.keyframes_writing(key))


class Request:
    """A clip's track request: its target, the name of one of the clip's own keys, an area or a clip target."""

    def __init__(self, clip, target):
        self.clip = clip
        self.target = target

    @property
    def where(self):
        return f"{self.clip.place}: track"


class ClipTarget:
    """A target naming a clip of the same sequence by its `id`, whose box is followed."""

    def __init__(self, identifier):
        self.identifier = identifier


class Target:
    """What `frames track` is given: a rectangle `[x, y, w, h]` with `--area`, or four points with `--quad`."""

    def __init__(self, option, value):
        self.option = option
        self.value = value


class Media:
    """The media a track follows: a video, or an image sequence's directory with the rate it is read at."""

    def __init__(self, path, fps):
        self.path = path
        self.fps = fps


def place_name(base, value):
    identifier = value.get("id") if isinstance(value, dict) else None
    return f"{base}#{identifier}" if isinstance(identifier, str) else base


def clips_of(document, nested=None):
    """The clips of a sequence, with places continued from the compound clip's place where it is nested."""
    base = f"{nested}.media." if nested else ""
    clips = []
    for index, value in enumerate(document.get("storyline") or []):
        if not isinstance(value, dict):
            continue
        place = place_name(f"{base}storyline[{index}]", value)
        clips.append(Clip(value, place, nested))
        for inner, connected in enumerate(value.get("connected") or []):
            if isinstance(connected, dict):
                clips.append(Clip(connected, place_name(f"{place}.connected[{inner}]", connected), nested))
    for index, value in enumerate(document.get("clips") or []):
        if isinstance(value, dict):
            clips.append(Clip(value, place_name(f"{base}clips[{index}]", value), nested))
    return clips


def every_clip(document, nested=None):
    """The clips of a sequence and of every compound clip in it written as a sequence object, at any depth. A nested
    document named by its path is another file, and a template instance's clips are its template's."""
    clips = clips_of(document, nested)
    for clip in list(clips):
        media = clip.value.get("media")
        if isinstance(media, dict) and media.get("kind") == "sequence":
            clips += every_clip(media, clip.place)
    return clips


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def is_rectangle(value):
    return isinstance(value, list) and len(value) == 4 and all(is_number(number) for number in value)


def is_point(value):
    return isinstance(value, list) and len(value) == 2 and all(is_number(number) for number in value)


def is_request(value):
    """Whether a value is a request, an object with the key `tool`, for this tool or another."""
    return isinstance(value, dict) and "tool" in value


def is_own(value):
    """Whether a value is a request this tool fills."""
    return is_request(value) and value["tool"] == TOOL


def requests_in(value, path, sink):
    """Every request among a clip's values, with the container that holds it, its key there and its path, past its
    connected clips, its `metadata`, which frames does not read, and a nested document, which is checked on its own."""
    entries = value.items() if isinstance(value, dict) else enumerate(value) if isinstance(value, list) else []
    for key, inner in entries:
        if isinstance(value, dict) and key in ("connected", "metadata"):
            continue
        name = f"{path}[{key}]" if isinstance(value, list) else f"{path}.{key}" if path else key
        if is_request(inner):
            sink.append((value, key, name))
        elif not (isinstance(inner, dict) and inner.get("kind") == "sequence"):
            requests_in(inner, name, sink)
    return sink


def check_template_arguments(clip):
    """Stops on a request of this tool among the arguments of a clip's template instance, a sequence argument's clips
    included, since where an argument lies is its template's, which `timeline` names by the template's places."""
    media = clip.value.get("media")
    if not (isinstance(media, dict) and media.get("kind") == "template"):
        return
    found = own_requests_anywhere(media.get("args"), "media.args")
    if found:
        raise Stop(f"{clip.place}: {found[0]}: a frames/track-motion request stands among the arguments of a template instance, whose clips are its template's, so it is not filled: write the track data")


def own_requests_anywhere(value, path):
    """The path of every request of this tool in a value, at any depth, nested documents included."""
    if is_own(value):
        return [path]
    entries = value.items() if isinstance(value, dict) else enumerate(value) if isinstance(value, list) else []
    found = []
    for key, inner in entries:
        found += own_requests_anywhere(inner, f"{path}[{key}]" if isinstance(value, list) else f"{path}.{key}")
    return found


def request_of(clip):
    """The clip's request, None where its `track` is absent, track data or a request for another tool."""
    check_template_arguments(clip)
    for holder, key, path in requests_in(clip.value, "", []):
        if is_own(holder[key]) and not (holder is clip.value and key == "track"):
            raise Stop(f"{clip.place}: {path}: a frames/track-motion request stands as a clip's track")
    value = clip.value.get("track")
    if not is_own(value):
        return None
    where = f"{clip.place}: track"
    unknown = sorted(set(value) - REQUEST_KEYS)
    if unknown:
        raise Stop(f"{where}: unknown key {json.dumps(unknown[0])} in a frames/track-motion request. Allowed: {', '.join(sorted(REQUEST_KEYS))}")
    if "target" not in value:
        raise Stop(f"{where}: a frames/track-motion request names its target, one of the clip's own keys {', '.join(TARGET_KEYS)} or an area [x, y, w, h]")
    target = value["target"]
    if isinstance(target, dict) and "clip" in target and not is_request(target):
        target = clip_target_of(target, f"{where}.target")
    elif isinstance(target, str):
        if target not in TARGET_KEYS:
            raise Stop(f"{where}.target: {json.dumps(target)} is none of the clip's own keys a target lies in: {', '.join(TARGET_KEYS)}")
    elif is_request(target):
        raise Stop(
            f"{where}.target: a request's arguments are values, and this one holds a request for {json.dumps(target['tool'])}: "
            f"write that request in the clip's own key and name the key as the target"
        )
    else:
        target = area_of(target, f"{where}.target")
    return Request(clip, target)


def clip_target_of(value, where):
    """A target naming a clip, which holds `clip` alone."""
    unknown = sorted(set(value) - CLIP_TARGET_KEYS)
    if unknown:
        raise Stop(f"{where}: unknown key {json.dumps(unknown[0])} in a clip target. Allowed: {', '.join(sorted(CLIP_TARGET_KEYS))}")
    if not isinstance(value["clip"], str):
        raise Stop(f"{where}.clip: a clip target names a clip by its id, a string")
    return ClipTarget(value["clip"])


def area_of(value, where):
    """A target area, a rectangle in the media pixels the track follows."""
    if is_rectangle(value):
        return value
    raise Stop(f"{where}: a target is the name of one of the clip's own keys, an area [x, y, w, h] in the media pixels the track follows or a clip {{\"clip\": \"<id>\"}}")


def check_filled(request):
    """Stops where the key a request names as its target holds a request, since the target is the value it is filled
    with, and is not found yet."""
    if not isinstance(request.target, str):
        return
    clip = request.clip
    key = request.target
    values = ([(key, clip.value[key])] if key in clip.value else []) + [
        (f"keyframes[{index}].{key}", keyframe[key]) for index, keyframe in enumerate(clip.value.get("keyframes") or [])
        if isinstance(keyframe, dict) and key in keyframe
    ]
    for path, value in values:
        found = [(value, path)] if is_request(value) else [(holder[inner], name) for holder, inner, name in requests_in(value, path, [])]
        for inner, name in found:
            raise Stop(
                f"{request.where}: its target {json.dumps(key)} holds a request for {json.dumps(inner['tool'])} at {name}, "
                f"which is not filled yet: run frames {inner['tool']} first, since the target is the value it finds"
            )


# MARK: - The target

def own_target(request, entry, tracked, times):
    """The target a request names by one of the clip's own keys and the sequence time whose frame it is on: the key, as
    its entry reports the space it is written in, `space` for an area and a corner pin and `ownSpace` for a crop and a
    mask, in the media pixels its track follows, on the clip's instant, or where it is keyframed, its first keyframe's
    value on that keyframe's `at` carried by the clip's clock. A mask is the rectangle that bounds the quads of the
    clip's `masks` at that time, carried into the pixels followed."""
    clip = request.clip
    key = request.target
    where = f"{request.where} ({key})"
    if not clip.written(key):
        raise Stop(f"{where}: the clip writes no {key}, which the request names as its target")
    followed = {"kind": "media", "clip": tracked["clip"]}
    space = entry["ownSpace"] if key in ("crop", "mask") else entry["space"]
    if space != followed:
        raise Stop(f"{where}: the clip writes its {key} in {space_text(space)}, not in the media pixels of {tracked['clip']}, which its track follows")
    if is_scale_crop(clip, key):
        raise Stop(f"{where}: a crop written as {{\"scale\": s}} is no area to follow")
    if clip.keyframes_writing(key):
        index, first = first_keyframe(clip, key)
        value = first[key]
        where = f"{clip.place}: keyframes[{index}].{key}"
        instant = keyframe_instant(clip, index, entry)
    else:
        value = clip.value[key]
        instant = entry["instant"]
    if key == "mask":
        masks = times.shown(clip.place, instant)["masks"]
        if not masks:
            raise Stop(f"{where}: timeline reports no mask of the clip at {number_text(instant)}")
        into = followed_pixels(times, tracked, instant, where)
        return Target("--area", bounding_rectangle([point for quad in masks for point in into(quad)])), instant
    if key == "cornerPin":
        if not (isinstance(value, list) and len(value) == 4 and all(is_point(point) for point in value)):
            raise Stop(f"{where}: a corner pin is followed from four points [x, y], and a clip area names no point in the media")
        return Target("--quad", value), instant
    return Target("--area", area_of(value, where)), instant


def clip_target(request, entry, tracked, times):
    """The target a request names as a clip's box and the sequence time whose frame it is on: the named clip's `quad`
    at the clip's instant, carried into the pixels followed."""
    where = f"{request.where}.target"
    instant = entry["instant"]
    named = times.named(request.target.identifier, instant)
    if named is None:
        raise Stop(f"{where}: no clip of the sequence has the id {json.dumps(request.target.identifier)}")
    if named["box"] is None:
        raise Stop(f"{where}: {named['place']} has no box to follow")
    into = followed_pixels(times, tracked, instant, where)
    return Target("--quad", into(named["box"]["quad"])), instant


def followed_pixels(times, tracked, instant, where):
    """The map that carries points in output pixels at an instant into the media pixels a track follows: the inverse
    of H(`rect` -> `quad`) of the clip whose media is followed, as `timeline --at` reports its box (FRAMES-23)."""
    place = tracked["clip"]
    box = times.shown(place, instant)["box"]
    if box is None:
        raise Stop(f"{where}: {place} reports no box at {number_text(instant)} to carry the target into its media pixels")
    x, y, width, height = box["rect"]
    corners = [[x, y], [x + width, y], [x + width, y + height], [x, y + height]]
    matrix = homography(box["quad"], corners) if width > 0 and height > 0 else None
    if matrix is None:
        raise Stop(f"{where}: the box of {place} at {number_text(instant)} covers no area, so no point of the output lies in its media pixels")

    def carry(points):
        carried = [projected(matrix, point) for point in points]
        if any(point is None for point in carried):
            raise Stop(f"{where}: a point of the target lies beyond the horizon of the media pixels of {place} at {number_text(instant)}")
        return [[rounded(number) for number in point] for point in carried]

    return carry


def homography(source, destination):
    """The projective map that takes each of four points to its counterpart, as three rows scaled so that the four
    points lie on the positive side of its horizon, None where three of either four lie on one line."""
    rows = []
    for (x, y), (u, v) in zip(source, destination):
        rows.append([x, y, 1, 0, 0, 0, -u * x, -u * y, u])
        rows.append([0, 0, 0, x, y, 1, -v * x, -v * y, v])
    for column in range(8):
        pivot = max(range(column, 8), key=lambda row: abs(rows[row][column]))
        if abs(rows[pivot][column]) < 1e-9:
            return None
        rows[column], rows[pivot] = rows[pivot], rows[column]
        for row in range(8):
            if row != column:
                factor = rows[row][column] / rows[column][column]
                rows[row] = [value - factor * lead for value, lead in zip(rows[row], rows[column])]
    a, b, c, d, e, f, g, h = (rows[index][8] / rows[index][index] for index in range(8))
    matrix = [[a, b, c], [d, e, f], [g, h, 1]]
    # A map whose four points lie on both sides of its horizon takes no convex quadrilateral to a rectangle.
    sides = {weight(matrix, point) > 0 for point in source}
    if len(sides) != 1 or any(abs(weight(matrix, point)) < 1e-12 for point in source):
        return None
    return matrix if sides == {True} else [[-value for value in row] for row in matrix]


def weight(matrix, point):
    """The homogeneous weight a projective map gives a point, positive on the side of its horizon its points lie on."""
    return matrix[2][0] * point[0] + matrix[2][1] * point[1] + matrix[2][2]


def projected(matrix, point):
    """A point carried by a projective map, None where it lies on or beyond the map's horizon."""
    x, y = point
    w = weight(matrix, point)
    if w < 1e-12:
        return None
    return [(matrix[0][0] * x + matrix[0][1] * y + matrix[0][2]) / w, (matrix[1][0] * x + matrix[1][1] * y + matrix[1][2]) / w]


def bounding_rectangle(points):
    """The rectangle `[x, y, w, h]` that bounds points."""
    xs = [point[0] for point in points]
    ys = [point[1] for point in points]
    return [rounded(min(xs)), rounded(min(ys)), rounded(max(xs) - min(xs)), rounded(max(ys) - min(ys))]


def space_text(space):
    """A space as `timeline` reports it, in words."""
    if space is None:
        return "no pixels"
    if space["kind"] == "output":
        return "output pixels"
    words = {"box": "box", "text": "text box", "media": "media pixels"}
    return f"the {words[space['kind']]} of {space['clip']}"


def first_keyframe(clip, key):
    """The index and the keyframe of the value the key takes at its first keyframe's `at`: of the keyframes that write
    it at the earliest `at`, the one written last, which the leaf takes at that `at`."""
    keyframes = clip.value["keyframes"]
    indices = [index for index, keyframe in enumerate(keyframes) if isinstance(keyframe, dict) and key in keyframe]
    for index in indices:
        if not is_number(keyframes[index].get("at")):
            raise Stop(f"{clip.place}: keyframes[{index}] needs a number at")
    earliest = min(keyframes[index]["at"] for index in indices)
    index = [index for index in indices if keyframes[index]["at"] == earliest][-1]
    return index, keyframes[index]


def keyframe_instant(clip, index, entry):
    """The sequence time of a keyframe's `at`, carried by the clock the clip's entry reports, `origin + at / speed`."""
    at = clip.value["keyframes"][index]["at"]
    clock = entry["clock"]
    return rounded(clock["origin"] + at / clock["speed"])


def is_scale_crop(clip, key):
    """Whether the key is a crop written as `{scale}`, which is no area."""
    if key != "crop":
        return False
    crops = ([clip.value["crop"]] if "crop" in clip.value else []) + [
        keyframe["crop"] for keyframe in clip.keyframes_writing("crop")
    ]
    return any(isinstance(crop, dict) and "scale" in crop for crop in crops)


# MARK: - Times

class Times:
    """Reads the entries of one sequence's clips from `timeline`, and from `timeline --at` the frame each clip's time
    map shows at an instant and where its box and masks lie: the document's own sequence, or with `nested` the
    sequence of the compound clip at that place, from `timeline --nested` on its own clock."""

    def __init__(self, frames, probe_path, clips, nested):
        self.frames = frames
        self.probe_path = probe_path
        self.clips = {clip.place: clip for clip in clips}
        self.scope = ["--nested", nested] if nested else []
        self.entries = None
        self.shown_at = {}

    def entry(self, place):
        """A clip's `timeline` entry: its kind, media, rate, instant, spaces and tracked media."""
        if self.entries is None:
            self.entries = entries_by_place(self.frames.report(["timeline", self.probe_path, *self.scope, "--json"]))
        return self.entries[place]

    def written(self, place):
        """The clip of the document at a place a report names."""
        return self.clips[place]

    def shown(self, place, time):
        """A clip's `timeline --at` entry at a sequence time, whose `mediaTime` is the frame its time map shows."""
        return self.shown_all(time)[place]

    def named(self, identifier, time):
        """The `timeline --at` entry at a sequence time of the clip of the sequence with an id, None where none has it."""
        return next((entry for entry in self.shown_all(time).values() if entry["id"] == identifier), None)

    def shown_all(self, time):
        if time not in self.shown_at:
            report = self.frames.report(["timeline", self.probe_path, *self.scope, "--at", number_text(time), "--json"])
            self.shown_at[time] = entries_by_place(report)
        return self.shown_at[time]


def entries_by_place(report):
    return {entry["place"]: entry for entry in report["storyline"] + report["clips"]}


# MARK: - Following

def follow(request, frames, times):
    """The track data of one request: the target followed from the track's frame to the first and to the last frame
    `tracked` reports, the frames of both joined in time order."""
    entry = times.entry(request.clip.place)
    tracked = entry["tracked"]
    if tracked is None:
        raise Stop(f"{request.where}: timeline reports no video or image sequence for its track to follow")
    if isinstance(request.target, str):
        target, instant = own_target(request, entry, tracked, times)
    elif isinstance(request.target, ClipTarget):
        target, instant = clip_target(request, entry, tracked, times)
    else:
        target, instant = Target("--area", request.target), entry["instant"]
    source = times.entry(tracked["clip"])
    media = Media(source["media"], source["fps"])
    time = times.shown(tracked["clip"], instant)["mediaTime"]
    color_space = times.written(tracked["clip"]).value.get("colorSpace")
    before = frames.track(media, time, target, tracked["first"], color_space)
    after = frames.track(media, time, target, tracked["last"], color_space)
    # Both are followed from the track's frame, so the frames of `after` that `before` lacks lie past its frames.
    times_before = {frame["time"] for frame in before["frames"]}
    joined = before["frames"] + [frame for frame in after["frames"] if frame["time"] not in times_before]
    return {"time": before["time"], "frames": joined}


# MARK: - The tool

def number_text(value):
    """A number as frames' machine output writes it, to the microsecond."""
    value = rounded(value)
    return str(int(value)) if float(value).is_integer() else repr(value)


def rounded(value):
    value = round(float(value), 6)
    return int(value) if value.is_integer() else value


def probe_document(document):
    """The document with a value in the place of every request, since frames takes none, so frames resolves it and
    reports every clip's whole window: no `track` where a track request stands, and a placeholder rectangle where an
    area stands, since a clip's times, spaces and tracked frames do not depend on them. A request standing anywhere else
    has no value that keeps those facts, and stops."""
    copy = json.loads(json.dumps(document))
    for clip in every_clip(copy):
        for holder, key, path in requests_in(clip.value, "", []):
            if key == "track" and holder is clip.value:
                del holder[key]
            elif key in AREA_KEYS:
                holder[key] = PLACEHOLDER
            else:
                tool = holder[key]["tool"]
                raise Stop(f"{clip.place}: {path}: a request for {json.dumps(tool)} stands where frames/track-motion has no value to time the document with, so it is filled first")
    return copy


def parse(arguments):
    options = []
    document = None
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in ("--help", "-h"):
            print(USAGE)
            sys.exit(0)
        if argument in GLOBAL_OPTIONS:
            if index + 1 >= len(arguments):
                raise Stop(f"{argument} needs a value")
            options += [argument, arguments[index + 1]]
            index += 2
            continue
        if argument.startswith("--"):
            raise Stop(f"unknown option {argument}")
        if document is not None:
            raise Stop(f"one document is taken, and {argument} is a second")
        document = argument
        index += 1
    if document is None:
        raise Stop("a document is needed, as an absolute path or -")
    if document != "-" and not document.startswith("/"):
        raise Stop(f"<document.json> {json.dumps(document)} is not an absolute path, and paths are absolute")
    return options, document


def load(document):
    try:
        if document == "-":
            text = sys.stdin.read()
        else:
            with open(document, encoding="utf-8") as file:
                text = file.read()
    except OSError as error:
        raise Stop(f"cannot read {document}: {error.strerror}")
    try:
        value = json.loads(text)
    except json.JSONDecodeError as error:
        raise Stop(f"{document} is not JSON: {error}")
    if not isinstance(value, dict) or value.get("kind") != "sequence":
        raise Stop(f"{document} is not a sequence document")
    return value


def run(arguments, executable):
    """The document with every request of this tool filled. `executable` is the frames that runs the tool, which every
    frames command it needs is run with, or None where no frames gave it."""
    options, path = parse(arguments)
    document = load(path)
    clips = every_clip(document)
    requests = [request for request in (request_of(clip) for clip in clips) if request is not None]
    for request in requests:
        check_filled(request)
    if not requests:
        return document

    if executable is None:
        raise Stop("FRAMES_EXECUTABLE is not set: the tool is run by frames, as frames frames/track-motion")
    frames = Frames(executable, options)

    with tempfile.TemporaryDirectory(prefix="track-motion-") as directory:
        probe_path = os.path.join(directory, "document.json")
        with open(probe_path, "w", encoding="utf-8") as file:
            json.dump(probe_document(document), file)
        scopes = {}
        for clip in clips:
            scopes.setdefault(clip.nested, []).append(clip)
        times = {nested: Times(frames, probe_path, inner, nested) for nested, inner in scopes.items()}
        tracks = [follow(request, frames, times[request.clip.nested]) for request in requests]
    for request, track in zip(requests, tracks):
        request.clip.value["track"] = track
    return document


def main():
    try:
        document = run(sys.argv[1:], os.environ.get("FRAMES_EXECUTABLE"))
    except Stop as stop:
        print(f"{TOOL}: {stop}", file=sys.stderr)
        return 1
    json.dump(document, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
