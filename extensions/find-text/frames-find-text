#!/usr/bin/env python3
"""frames-find-text: fills each `find-text` request of a document with the rectangle `frames ocr` finds for its text.

A request is an object with the key `tool` that stands where a value is still to be found, and the requests this
extension fills are those whose `tool` is `find-text`, standing where an area does. It asks frames where and when each
one is searched, reads the media with `frames ocr --json`, and prints the same document with each of its requests
replaced by a rectangle in the media pixels it is written in. A request for any other tool is left as written. It
reads only frames' machine output and never a resolved document.
"""

import json
import os
import subprocess
import sys
import tempfile

SUPPORTED_MAJOR = 0
GLOBAL_OPTIONS = ("--theme", "--decoder", "--renderer", "--mixer", "--encoder", "--shaper", "--tracker", "--ocr")
TOOL = "find-text"
TEXT_KEYS = {"tool", "text", "nth", "padding"}
RANGE_KEYS = {"tool", "from", "to", "fromNth", "toNth", "padding"}
AREA_KEYS = ("area", "crop")
PLACEHOLDER = [0, 0, 1, 1]
USAGE = """frames find-text <document.json | -> [--languages <tag>[,<tag>...]]

Prints the document with every request for find-text, standing where an area does, replaced by the rectangle
`frames ocr` finds, in the media pixels the area is written in:

  {"tool": "find-text", "text": t, "nth": n, "padding": p}          the recognised line that contains t
  {"tool": "find-text", "from": a, "to": b, "fromNth": n, "toNth": m, "padding": p}
                                                                    the lines from the one with a to the one with b

A request for any other tool is left as written.

  <document.json | ->           The document, as an absolute path, or - for standard input.
  --languages <tag>[,<tag>...]  The recognition languages passed to `frames ocr --languages`. Default: detected.
  --help                        Prints this help.

The global options of frames given before `find-text` are passed to every frames command it runs. The frames it
runs is the one on PATH, or the executable FRAMES_EXECUTABLE names."""


class Stop(Exception):
    """A reason the document cannot be written, printed as `frames-find-text: <reason>`."""


# MARK: - Frames

class Frames:
    """Runs frames commands and reads their machine output."""

    def __init__(self, executable, options):
        self.executable = executable
        self.options = options
        self.readings = {}

    def report(self, arguments):
        completed = subprocess.run(
            [self.executable] + self.options + arguments, capture_output=True, text=True
        )
        if completed.returncode != 0:
            message = completed.stderr.strip() or f"exit {completed.returncode}"
            raise Stop(f"frames {arguments[0]} failed: {message}")
        output = json.loads(completed.stdout)
        version = output.get(arguments[0])
        if major(version) != SUPPORTED_MAJOR:
            raise Stop(f"frames {arguments[0]} printed version {version!r}, and this extension reads {SUPPORTED_MAJOR}.x")
        return output

    def check_version(self):
        try:
            completed = subprocess.run([self.executable, "--version"], capture_output=True, text=True)
        except OSError as error:
            raise Stop(f"cannot run {self.executable}: {error.strerror}")
        version = completed.stdout.strip()
        if completed.returncode != 0 or major(version) != SUPPORTED_MAJOR:
            raise Stop(f"{self.executable} --version is {version!r}, and this extension is written for {SUPPORTED_MAJOR}.x")

    def ocr(self, picture, color_space, languages):
        key = (picture.path, picture.time, picture.page, picture.fps, color_space, languages)
        if key not in self.readings:
            arguments = ["ocr", picture.path, "--json"]
            if picture.fps is not None:
                arguments += ["--fps", number_text(picture.fps)]
            if picture.time is not None:
                arguments += ["--at", number_text(picture.time)]
            if picture.page is not None:
                arguments += ["--page", str(picture.page)]
            if color_space is not None:
                arguments += ["--color-space", color_space]
            if languages is not None:
                arguments += ["--languages", languages]
            self.readings[key] = self.report(arguments)["frames"][0]["lines"]
        return self.readings[key]


def major(version):
    """The major version of a version string, or None for anything else."""
    head = version.split(".")[0] if isinstance(version, str) else ""
    return int(head) if head.isdigit() else None


# MARK: - Requests

def is_request(value):
    """Whether a value is a request, an object with the key `tool`, for this tool or another."""
    return isinstance(value, dict) and "tool" in value


def is_own(value):
    """Whether a value is a request this tool fills."""
    return is_request(value) and value["tool"] == TOOL


def text_form_kind(value):
    """`text` for a request that names one text, `range` for one that names the lines from one text to another."""
    return "text" if "text" in value else "range"


def check_text_form(value, where):
    if "text" not in value and "from" not in value and "to" not in value:
        raise Stop(f"{where}: a find-text request names text, or the lines from one text to another with from and to")
    kind = text_form_kind(value)
    keys = TEXT_KEYS if kind == "text" else RANGE_KEYS
    unknown = sorted(set(value) - keys)
    if unknown:
        raise Stop(f"{where}: unknown key {json.dumps(unknown[0])} in a find-text request. Allowed: {', '.join(sorted(keys))}")
    texts = ["text"] if kind == "text" else ["from", "to"]
    for key in texts:
        if not isinstance(value.get(key), str) or not squeeze(value[key]):
            raise Stop(f"{where}: {key} needs text that is not only whitespace")
    for key in ("nth", "fromNth", "toNth"):
        if key in value and (not isinstance(value[key], int) or isinstance(value[key], bool) or value[key] < 0):
            raise Stop(f"{where}: {key} is a whole number, 0 or more")
    padding = value.get("padding", 0)
    if not isinstance(padding, (int, float)) or isinstance(padding, bool) or padding < 0:
        raise Stop(f"{where}: padding is a number, 0 or more")


def squeeze(text):
    return "".join(text.split())


def matches(lines, text):
    wanted = squeeze(text)
    return [line for line in lines if wanted in squeeze(line["text"])]


def pick(lines, text, nth, where, source):
    found = matches(lines, text)
    if nth is None:
        if len(found) == 1:
            return found[0]
        if not found:
            raise Stop(f"{where}: {json.dumps(text)} (no nth) matches no recognised line in {source}")
        listed = "\n".join(f"  {rect_text(line['rect'])}  {line['text']}" for line in found)
        raise Stop(f"{where}: {json.dumps(text)} matches {len(found)} lines in {source}, so it needs an nth:\n{listed}")
    if nth >= len(found):
        raise Stop(f"{where}: {json.dumps(text)} nth {nth} is past the {len(found)} recognised lines that contain it in {source}")
    return found[nth]


def find(form, lines, where, source):
    """The rectangle a request names among the lines of one picture, padding included."""
    if text_form_kind(form) == "text":
        rect = pick(lines, form["text"], form.get("nth"), where, source)["rect"]
    else:
        first = pick(lines, form["from"], form.get("fromNth"), f"{where} (from)", source)["rect"]
        last = pick(lines, form["to"], form.get("toNth"), f"{where} (to)", source)["rect"]
        top = min(first[1], last[1])
        bottom = max(first[1] + first[3], last[1] + last[3])
        rects = [first, last] + [
            line["rect"] for line in lines if top <= line["rect"][1] + line["rect"][3] / 2 <= bottom
        ]
        rect = bounding(rects)
    padding = form.get("padding", 0)
    return [rounded(rect[0] - padding), rounded(rect[1] - padding), rounded(rect[2] + 2 * padding), rounded(rect[3] + 2 * padding)]


def bounding(rects):
    left = min(rect[0] for rect in rects)
    top = min(rect[1] for rect in rects)
    right = max(rect[0] + rect[2] for rect in rects)
    bottom = max(rect[1] + rect[3] for rect in rects)
    return [left, top, right - left, bottom - top]


# MARK: - Walking the document

class Clip:
    """A clip of the outermost document at its place, as reports name it."""

    def __init__(self, value, place):
        self.value = value
        self.place = place


class Found:
    """A request of this tool in the document: where it is, the container that holds it and its key there."""

    def __init__(self, clip, path, holder, key, keyframe, role):
        self.clip = clip
        self.path = path
        self.holder = holder
        self.key = key
        self.keyframe = keyframe
        self.role = role

    @property
    def form(self):
        return self.holder[self.key]

    @property
    def where(self):
        return f"{self.clip.place}: {self.path}"


def place_name(base, value):
    identifier = value.get("id") if isinstance(value, dict) else None
    return f"{base}#{identifier}" if isinstance(identifier, str) else base


def clips_of(document):
    clips = []
    for index, value in enumerate(document.get("storyline") or []):
        if not isinstance(value, dict):
            continue
        place = place_name(f"storyline[{index}]", value)
        clips.append(Clip(value, place))
        for inner, connected in enumerate(value.get("connected") or []):
            if isinstance(connected, dict):
                clips.append(Clip(connected, place_name(f"{place}.connected[{inner}]", connected)))
    for index, value in enumerate(document.get("clips") or []):
        if isinstance(value, dict):
            clips.append(Clip(value, place_name(f"clips[{index}]", value)))
    return clips


def forms_in_area(holder, key, path, sink, role):
    if is_own(holder.get(key) if isinstance(holder, dict) else None):
        sink.append((path, holder, key, role))


def forms_in_point(holder, key, path, sink, role):
    point = holder[key] if isinstance(holder, (dict, list)) else None
    if isinstance(point, dict) and "area" in point:
        forms_in_area(point, "area", f"{path}.area", sink, role)
    elif isinstance(point, dict) and "vertex" in point:
        forms_in_point(point, "vertex", f"{path}.vertex", sink, role)


def forms_in_points(holder, key, path, sink, role):
    points = holder.get(key)
    if isinstance(points, list):
        for index in range(len(points)):
            forms_in_point(points, index, f"{path}[{index}]", sink, role)


def forms_in_masks(holder, path, sink):
    masks = holder.get("mask")
    entries = [(masks, "mask")] if isinstance(masks, dict) else [
        (mask, f"mask[{index}]") for index, mask in enumerate(masks) if isinstance(mask, dict)
    ] if isinstance(masks, list) else []
    for mask, name in entries:
        forms_in_area(mask, "area", f"{path}{name}.area", sink, "mask")
        forms_in_points(mask, "points", f"{path}{name}.points", sink, "mask")
        if "position" in mask:
            forms_in_point(mask, "position", f"{path}{name}.position", sink, "mask")


def forms_in_values(holder, path, sink):
    """Every request of this tool among the area and point keys of a clip or a keyframe."""
    forms_in_area(holder, "crop", f"{path}crop", sink, "crop")
    forms_in_area(holder, "area", f"{path}area", sink, "space")
    forms_in_points(holder, "points", f"{path}points", sink, "space")
    forms_in_points(holder, "cornerPin", f"{path}cornerPin", sink, "space")
    if "position" in holder:
        forms_in_point(holder, "position", f"{path}position", sink, "space")
    forms_in_masks(holder, path, sink)


def text_forms(clip):
    sink = []
    forms_in_values(clip.value, "", sink)
    found = [Found(clip, path, holder, key, None, role) for path, holder, key, role in sink]
    for index, keyframe in enumerate(clip.value.get("keyframes") or []):
        if isinstance(keyframe, dict):
            sink = []
            forms_in_values(keyframe, f"keyframes[{index}].", sink)
            found += [Found(clip, path, holder, key, index, role) for path, holder, key, role in sink]
    return found


def requests_in(value, path, sink):
    """Every request among a clip's values, with the container that holds it, its key there and its path, past its
    connected clips, its `metadata`, which frames does not read, and a nested document, which is checked on its own."""
    entries = value.items() if isinstance(value, dict) else enumerate(value) if isinstance(value, list) else []
    for key, inner in entries:
        if isinstance(value, dict) and key in ("connected", "metadata"):
            continue
        name = f"{path}[{key}]" if isinstance(value, list) else f"{path}.{key}" if path else key
        if is_request(inner):
            sink.append((value, key, name))
        elif not (isinstance(inner, dict) and inner.get("kind") == "sequence"):
            requests_in(inner, name, sink)
    return sink


def check_placed(clip, found):
    """Stops on a request of this tool that stands where no area does."""
    placed = {id(entry.form) for entry in found}
    for holder, key, path in requests_in(clip.value, "", []):
        if is_own(holder[key]) and id(holder[key]) not in placed:
            raise Stop(f"{clip.place}: {path}: a find-text request stands where an area does, as a crop, an area, a mask's area or the area of a point")


def nested_text_forms(document, place):
    """The place of the first request of this tool inside a nested document, or None."""
    for clip in clips_of(document):
        found = [path for holder, key, path in requests_in(clip.value, "", []) if is_own(holder[key])]
        if found:
            return f"{place}.{clip.place}: {found[0]}"
        media = clip.value.get("media")
        if isinstance(media, dict) and media.get("kind") == "sequence":
            inner = nested_text_forms(media, f"{place}.{clip.place}.media")
            if inner:
                return inner
    return None


# MARK: - Where a request is searched

def refuse(found, reason):
    raise Stop(f"{found.where}: the place is not in a medium's pixels, so its text cannot be searched: {reason}")


def searched_place(found, times):
    """The place of the clip whose media a request is searched in: the clip whose media pixels its entry reports as
    the space the key is written in, `ownSpace` for a crop and a mask and `space` for every other key."""
    entry = times.entry(found.clip.place)
    space = entry["ownSpace"] if found.role in ("crop", "mask") else entry["space"]
    if space is None:
        refuse(found, "an audio clip has no picture")
    if space["kind"] == "output":
        refuse(found, "it is written in output pixels")
    if space["kind"] == "box":
        refuse(found, f"it is written in the box of {space['clip']}" + clip_area_hint(found, times.entry(space["clip"])))
    if times.entry(space["clip"])["kind"] == "compound":
        refuse(found, f"it is written in the media pixels of {space['clip']}, a compound clip or template instance, whose picture is drawn, not read")
    return space["clip"]


def clip_area_hint(found, parent):
    """How a place in the box of a parent rect or ellipse is written: as that parent's clip area, which an area and
    the area of a point take in the space a parent gives its children. A crop and a mask lie in the clip's own box,
    where a clip area stops, so they get none, and so does a title's box, whose text `evaluate` reports. A parent is
    named by its id, so it has one."""
    if found.role != "space" or parent["kind"] not in ("rect", "ellipse"):
        return ""
    area = {"clip": parent["id"]}
    if is_point(found):
        written = {"area": area, "point": found.holder["point"]} if "point" in found.holder else {"area": area}
    else:
        written = area
    return f", a {parent['kind']} placed by width and height, so write the place as that clip's area: {json.dumps(written, ensure_ascii=False)}"


def is_point(found):
    """Whether a request stands as the area of a point, held by the point and not by the clip or a keyframe."""
    keyframes = found.clip.value.get("keyframes") or []
    keyframe = keyframes[found.keyframe] if found.keyframe is not None else None
    return found.holder is not found.clip.value and found.holder is not keyframe


# MARK: - The frame searched

class Times:
    """Reads each clip's entry from `timeline`, and from `timeline --at` the frame its time map shows at an instant."""

    def __init__(self, frames, probe_path, clips):
        self.frames = frames
        self.probe_path = probe_path
        self.clips = {clip.place: clip for clip in clips}
        self.entries = None
        self.shown_at = {}

    def entry(self, place):
        """A clip's `timeline` entry: its kind, media, instant, clock and spaces."""
        if self.entries is None:
            self.entries = entries_by_place(self.frames.report(["timeline", self.probe_path, "--json"]))
        return self.entries[place]

    def written(self, place):
        """The clip of the document at a place a report names."""
        return self.clips[place]

    def shown(self, place, time):
        """A clip's `timeline --at` entry at a sequence time, whose `mediaTime` is the frame its time map shows."""
        if time not in self.shown_at:
            report = self.frames.report(["timeline", self.probe_path, "--at", number_text(time), "--json"])
            self.shown_at[time] = entries_by_place(report)
        return self.shown_at[time][place]


def entries_by_place(report):
    return {entry["place"]: entry for entry in report["storyline"] + report["clips"]}


class Picture:
    """One picture to read: a media file or an image sequence's directory with its rate, the media time of a frame
    of a video or an image sequence, and a PDF page."""

    def __init__(self, path, time, page, fps):
        self.path = path
        self.time = time
        self.page = page
        self.fps = fps

    def describe(self):
        where = self.path + (f" page {self.page}" if self.page is not None else "")
        return where + (f" at {number_text(self.time)}" if self.time is not None else "")


def picture_of(found, searched, times):
    """The picture a request is searched in: the frame of the searched clip's media its time map shows at the
    sequence time the form takes effect at, the clip's instant or a keyframe's `at` carried by the clip's clock."""
    entry = times.entry(found.clip.place)
    if found.keyframe is None:
        instant = entry["instant"]
    else:
        at = found.clip.value["keyframes"][found.keyframe].get("at")
        if not isinstance(at, (int, float)) or isinstance(at, bool):
            raise Stop(f"{found.clip.place}: keyframes[{found.keyframe}] needs a number at")
        clock = entry["clock"]
        instant = rounded(clock["origin"] + at / clock["speed"])
    shown = times.shown(searched, instant)
    return picture(shown, shown["mediaTime"])


def picture(entry, time):
    """A clip's media read at a media time: a still or a page as it is, and a video or an image sequence, at the rate
    its entry reports, at the time."""
    if entry["kind"] in ("image", "page"):
        return Picture(entry["media"], None, entry["page"], None)
    return Picture(entry["media"], time, None, entry["fps"])


# MARK: - The extension

def number_text(value):
    value = rounded(value)
    return str(int(value)) if float(value).is_integer() else repr(value)


def rounded(value):
    value = round(float(value), 6)
    return int(value) if value.is_integer() else value


def rect_text(rect):
    return "[" + ", ".join(number_text(value) for value in rect) + "]"


def probe_document(document):
    """The document with a value in the place of every request, since frames takes none, so frames resolves it and
    times its clips as it times the document once its requests are filled: a placeholder rectangle where an area
    stands, and no `track` where a track request stands, since a clip's times and spaces do not depend on its track.
    A request standing anywhere else has no value that keeps those facts, and stops."""
    copy = json.loads(json.dumps(document))
    for clip in clips_of(copy):
        for holder, key, path in requests_in(clip.value, "", []):
            if key == "track" and holder is clip.value:
                del holder[key]
            elif key in AREA_KEYS:
                holder[key] = PLACEHOLDER
            else:
                tool = holder[key]["tool"]
                raise Stop(f"{clip.place}: {path}: a request for {json.dumps(tool)} stands where frames-find-text has no value to time the document with, so it is filled first")
    return copy


def parse(arguments):
    options = []
    document = None
    languages = None
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in ("--help", "-h"):
            print(USAGE)
            sys.exit(0)
        if argument in GLOBAL_OPTIONS or argument == "--languages":
            if index + 1 >= len(arguments):
                raise Stop(f"{argument} needs a value")
            if argument == "--languages":
                languages = arguments[index + 1]
            else:
                options += [argument, arguments[index + 1]]
            index += 2
            continue
        if argument.startswith("--"):
            raise Stop(f"unknown option {argument}")
        if document is not None:
            raise Stop(f"one document is taken, and {argument} is a second")
        document = argument
        index += 1
    if document is None:
        raise Stop("a document is needed, as an absolute path or -")
    if document != "-" and not document.startswith("/"):
        raise Stop(f"<document.json> {json.dumps(document)} is not an absolute path, and paths are absolute")
    return options, document, languages


def load(document):
    try:
        if document == "-":
            text = sys.stdin.read()
        else:
            with open(document, encoding="utf-8") as file:
                text = file.read()
    except OSError as error:
        raise Stop(f"cannot read {document}: {error.strerror}")
    try:
        value = json.loads(text)
    except json.JSONDecodeError as error:
        raise Stop(f"{document} is not JSON: {error}")
    if not isinstance(value, dict) or value.get("kind") != "sequence":
        raise Stop(f"{document} is not a sequence document")
    return value


def run(arguments):
    options, path, languages = parse(arguments)
    document = load(path)
    clips = clips_of(document)
    found = [entry for clip in clips for entry in text_forms(clip)]
    for clip in clips:
        media = clip.value.get("media")
        if isinstance(media, dict) and media.get("kind") == "sequence":
            inner = nested_text_forms(media, f"{clip.place}.media")
            if inner:
                raise Stop(f"{inner}: its text cannot be searched: it is inside a compound clip or template instance, and timeline --at gives a nested document's clips at the outer sequence's times only")
    for clip in clips:
        check_placed(clip, [entry for entry in found if entry.clip is clip])
    for entry in found:
        check_text_form(entry.form, entry.where)
    if not found:
        return document

    frames = Frames(os.environ.get("FRAMES_EXECUTABLE") or "frames", options)
    frames.check_version()

    with tempfile.TemporaryDirectory(prefix="frames-find-text-") as directory:
        probe_path = os.path.join(directory, "document.json")
        with open(probe_path, "w", encoding="utf-8") as file:
            json.dump(probe_document(document), file)
        times = Times(frames, probe_path, clips)
        searched = [searched_place(entry, times) for entry in found]
        rects = []
        for entry, place in zip(found, searched):
            read = picture_of(entry, place, times)
            lines = frames.ocr(read, times.written(place).value.get("colorSpace"), languages)
            rects.append(find(entry.form, lines, entry.where, read.describe()))
    for entry, rect in zip(found, rects):
        entry.holder[entry.key] = rect
    return document


def main():
    try:
        document = run(sys.argv[1:])
    except Stop as stop:
        print(f"frames-find-text: {stop}", file=sys.stderr)
        return 1
    json.dump(document, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
