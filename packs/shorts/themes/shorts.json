{
  "baseWidth": 1080,
  "font": ["Apple SD Gothic Neo"],
  "colors": { "accent": "#FF3B30", "highlight": "#FFE14D" },
  "styles": {
    "subtitle": { "size": 66, "weight": "bold", "stroke": { "width": 7, "color": "#000000" }, "offset": 330 },
    "subtitle-highlight": { "size": 66, "weight": "bold", "color": "highlight", "stroke": { "width": 7, "color": "#000000" } },
    "headline": { "size": 84, "weight": "bold", "lineHeight": 104, "placement": "top", "offset": 110, "align": "center", "lines": 2 },
    "headline-highlight": { "size": 84, "weight": "bold", "color": "highlight" },
    "label": { "size": 40, "weight": "bold", "color": "#FFFFFF",
               "background": { "color": "accent", "padding": [8, 16], "radius": 12 }, "lines": 1 }
  },
  "shapes": {
    "outline": { "stroke": { "width": 10 }, "radius": 18 },
    "bar": { "fill": "#000000" }
  },
  "placement": { "padding": 40 },
  "defaults": {
    "transition": { "preset": "frames/push-up", "seconds": 0.3 },
    "animation": { "title": { "subtitle": "frames/pop", "label": "frames/pop" }, "media": "frames/pop" }
  }
}
