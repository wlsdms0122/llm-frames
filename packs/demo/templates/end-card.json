{
  "kind": "sequence",
  "format": { "size": [1920, 1080], "fps": 30, "background": "#000000" },
  "theme": "demo/demo",
  "params": {
    "headline": { "type": "text", "default": "Available in version 2.4", "description": "the first line: where to get the feature" },
    "detail": { "type": "text", "default": "Settings > Checkout > Shipping", "description": "the second line, small and in the highlight colour: where to find it" },
    "length": { "type": "number", "default": 2, "description": "seconds on screen" }
  },
  "storyline": [
    { "kind": "solid", "color": "#000000", "duration": { "param": "length" },
      "connected": [
        { "kind": "title", "text": [ { "text": { "param": "headline" } }, { "text": "\n" }, { "text": { "param": "detail" }, "style": "kicker" } ],
          "style": "title", "placement": "center", "animation": "frames/fade" }
      ] }
  ]
}
