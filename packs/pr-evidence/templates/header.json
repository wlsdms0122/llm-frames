{
  "kind": "sequence",
  "format": { "size": [1206, 208], "fps": 30, "background": "#FFFFFF" },
  "theme": "pr-evidence/pr-evidence",
  "params": {
    "conclusion": { "type": "text", "default": "Total includes shipping", "description": "the first line, in bold: what the change makes true" },
    "reason": { "type": "text", "default": "42,000 is the item total plus 4,000 shipping", "description": "the second line: what in the picture proves it" }
  },
  "storyline": [
    { "kind": "solid", "color": "#FFFFFF", "duration": 1,
      "connected": [
        { "kind": "title", "text": { "param": "conclusion" }, "style": "lead", "anchor": "top-left", "position": [40, 40] },
        { "kind": "title", "text": { "param": "reason" }, "style": "body", "anchor": "top-left", "position": [40, 104] }
      ] }
  ]
}
