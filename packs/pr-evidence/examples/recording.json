  "clips": [
    { "media": { "template": "pr-evidence/header",
                 "args": { "conclusion": "Adding shipping updates the total", "reason": "The total goes from 38,000 to 42,000 as shipping is added" } },
      "width": 1280, "anchor": "bottom-left", "position": [0, 0] }
  ]
