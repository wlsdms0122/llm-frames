        { "at": [1.2, 2.8], "shape": "rect", "style": "outline", "id": "total", "parent": "checkout",
          "area": { "tool": "find-text", "from": "Total", "to": "42,000", "padding": 12 },
          "track": { "tool": "track-motion", "target": "area" } },
        { "at": [1.2, 2.8], "title": "38,000 + 4,000", "style": "label", "parent": "total",
          "position": { "area": { "clip": "total" }, "point": "bottom-right" }, "anchor": "top-right" }
      ] }
