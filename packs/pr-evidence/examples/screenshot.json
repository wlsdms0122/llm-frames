{
  "kind": "sequence",
  "theme": "pr-evidence/pr-evidence",
  "format": { "size": { "fit": "content" }, "fps": 30, "background": "#FFFFFF" },
  "storyline": [
    { "id": "checkout", "kind": "media", "media": "/path/to/checkout.png", "duration": 1, "crop": [0, 130, 1206, 800], "border": true,
      "connected": [
        { "kind": "rect", "style": "cover", "parent": "checkout", "area": { "tool": "frames/find-text", "text": "jane@example.com", "padding": 12 } },
        { "kind": "rect", "style": "outline", "parent": "checkout", "area": { "tool": "frames/find-text", "from": "Item total", "to": "38,000", "padding": 16 } },
        { "kind": "rect", "style": "outline", "parent": "checkout", "area": { "tool": "frames/find-text", "from": "Shipping", "to": "4,000", "padding": 16 } },
        { "kind": "rect", "style": "outline", "id": "total", "parent": "checkout",
          "area": { "tool": "frames/find-text", "from": "Total", "to": "42,000", "toNth": 0, "padding": 16 } },
        { "kind": "title", "text": "38,000 + 4,000", "style": "label", "parent": "total",
          "position": { "area": { "clip": "total" }, "point": "bottom-right" }, "anchor": "top-right" }
      ] }
  ],
  "clips": [
    { "kind": "media", "media": { "kind": "template", "template": "pr-evidence/header",
                 "args": { "conclusion": "Total includes shipping", "reason": "42,000 is the item total plus 4,000 shipping" } },
      "width": 1206, "anchor": "bottom-left", "position": [0, 0] }
  ]
}
